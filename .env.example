# Copy to .env.local and paste your public Mapbox token (starts with pk.).
# Without it the dive to Nagpur uses NASA imagery only.
VITE_MAPBOX_TOKEN=

# Enquiry form: get a free access key at https://web3forms.com with the email address that
# should receive enquiries. Without it the form shows a 'not connected yet' message.
VITE_WEB3FORMS_KEY=
